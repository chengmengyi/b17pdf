<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/b17_timer_overlay_one_bg_dej">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/icon_logo"
                    android:layout_width="50dp"
                    android:layout_height="50dp"/>
                <TextView
                    android:id="@+id/app_name_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PDF Reader"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#242C3C"
                    android:layout_marginLeft="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:background="@drawable/b17_continue_bg_dfjk">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/b17_continue_lock_df"/>
                <TextView
                    android:id="@+id/timer_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#2897F3"
                    android:layout_marginLeft="4dp"
                    android:textStyle="bold"/>
            </LinearLayout>
            <TextView
                android:id="@+id/title_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#242C3C"
                android:textStyle="bold"
                android:layout_marginTop="15dp"/>
            <TextView
                android:id="@+id/desc_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#555978"
                android:layout_marginTop="7dp"/>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="152dp"
                android:src="@drawable/b17_time_overlay_one_images"
                android:scaleType="fitXY"
                android:layout_marginTop="12dp"/>
            <TextView
                android:id="@+id/btn_text"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/b17_timer_overlay_one_btn_bg_fhef"
                android:gravity="center"
                android:text="Check"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                />
        </LinearLayout>
        <ImageView
            android:id="@+id/close_img"
            android:layout_width="33dp"
            android:layout_height="33dp"
            android:src="@drawable/b17_close_images"
            android:layout_marginTop="6dp"
            android:layout_marginRight="6dp"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</RelativeLayout>
